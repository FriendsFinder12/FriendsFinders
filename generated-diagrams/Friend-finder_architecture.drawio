                <mxCell id="finops_itemized" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;" value="&lt;b style=&quot;font-size: 12px; color: #1E293B;&quot;&gt;Itemized Pay-As-You-Go Monthly Breakdown&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.6; color: #334155;&quot;&gt;&lt;b style=&quot;color: #ED7100;&quot;&gt;⚡ AWS Lambda (3 Handlers):&lt;/b&gt; 256 MB RAM, pay-per-invocation &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$1.00 – $3.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #C925D1;&quot;&gt;🗄️ DynamoDB (4 Tables):&lt;/b&gt; On-Demand R/W + TTL + Streams &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$2.00 – $5.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #8C4FFF;&quot;&gt;🚪 API Gateway v2 (HTTP + WS):&lt;/b&gt; Pay-per-message &amp;amp; connection &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$1.00 – $3.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #E7157B;&quot;&gt;📈 CloudWatch Logs &amp;amp; Metrics:&lt;/b&gt; Logs, alarms, dashboard &amp;amp; X-Ray &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$1.00 – $2.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #7AA116;&quot;&gt;📦 S3 &amp;amp; CloudFront:&lt;/b&gt; Frontend CDN + Avatar uploads &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;&amp;lt; $0.50&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #CC2264;&quot;&gt;🔐 Cognito &amp;amp; SSM Store:&lt;/b&gt; 50k MAUs free tier + Standard params &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;$0.00 (Free)&lt;/b&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="205" width="450" x="930" y="915" as="geometry"/>
                </mxCell>
                <mxCell id="finops_total_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;span style=&quot;font-size: 11px; color: #166534; font-weight: bold; text-transform: uppercase;&quot;&gt;Total Estimated Monthly Cost&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 22px; color: #15803D;&quot;&gt;~$5.00 – $10.00 / mo&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #166534;&quot;&gt;Full Serverless MVP 24/7 (Pay-As-You-Go)&lt;/span&gt;" vertex="1">
